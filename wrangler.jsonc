{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: no Worker script runs, requests are served straight from out/.
  "name": "sprite-bench",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Workers Logs is on, but with no script nothing is invoked, so plain asset
  // requests produce no log entries (see "Reading the logs" in DEPLOY.md).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sprite-bench.n8builds.dev", "custom_domain": true }]
}
