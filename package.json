{
  "name": "sprite-bench",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
