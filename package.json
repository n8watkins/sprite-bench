{
  "name": "sprite-bench",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "check:edges": "node scripts/check-edges.mjs http://127.0.0.1:8787"
  },
  "dependencies": {
    "@sentry/browser": "11.11.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
